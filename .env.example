# Copy to .env for local development (pnpm run dev / pnpm run cli read it). Reference: docs/configuration.md

CONFIG_PATH=config/config.yml
LOG_LEVEL=debug
NODE_ENV=development

# Required
SERVER_DATA_PATH=data
SERVER_QUEUE_REDIS_URL=redis://localhost:6379
# publicly reachable HTTPS URL, e.g. the ngrok URL from docker-compose
SERVER_DRIVE_MONITOR_WEBHOOK_URL=https://your-public-url.example.com

# Optional (defaults shown)
# SERVER_HTTP_PORT=3000
# SERVER_QUEUE_REDIS_PREFIX=paperless-gdrive-link
# SERVER_QUEUE_CONCURRENCY_COLLECT=5
# SERVER_QUEUE_CONCURRENCY_PROCESS=1
# SERVER_QUEUE_CONCURRENCY_RENEW=1
# SERVER_QUEUE_DEBOUNCE_COLLECT_CHANGES_SEC=5
# SERVER_QUEUE_RENEW_POLL_INTERVAL_SEC=15
